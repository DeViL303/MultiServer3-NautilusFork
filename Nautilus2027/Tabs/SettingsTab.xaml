<UserControl x:Class="Nautilus2027.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nautilus2027;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Define styles that only apply to content within this TabItem -->
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="12"/>
                <!-- Smaller font size for text blocks -->
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="FontSize" Value="12"/>
                <!-- Smaller font size for text boxes -->
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource DarkModeButtonStyle}">
                <Setter Property="FontSize" Value="12"/>
                <!-- Smaller font size for buttons -->
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- settings scroll if the window is short; the support line stays 10px above the bottom -->
    <Grid Background="#242424">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Background="#242424">
            <!-- Output folders: one per tab; each tool writes to its own folder inside it (rows built in SettingsTab.xaml.cs) -->
            <TextBlock Text="Output folders (one per tab; each tool of the tab writes into its own folder inside it)" Foreground="#A0A0A0" Margin="10,8,5,2"/>
            <StackPanel x:Name="OutputFoldersPanel"/>

            <StackPanel Orientation="Horizontal"  Height="0" VerticalAlignment="Bottom">
                <TextBlock Text="Choose a theme color:" Foreground="White" Margin="5" Width="160"/>
                <xctk:ColorPicker x:Name="ThemeColorPicker" Cursor="Hand" Width="67" Height="29"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5,5,5,8">
                <TextBlock Text="Enable Debug Logs:" Foreground="White" VerticalAlignment="Center" Width="160" Margin="0,0,5,0"/>
                <CheckBox x:Name="ToggleSwitchDebugLogEnable" Unchecked="CheckBoxDebugLogsEnable_UnChecked" Checked="CheckBoxDebugLogsEnable_Checked" Style="{StaticResource ModernToggleSwitchStyle}" />
                <Button Content="View Log" Cursor="Hand" Style="{StaticResource DarkModeButtonSmallStyle}" FontSize="14" Margin="5,0,0,0" Width="90" Click="ViewLogButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5,0,5,8">
                <TextBlock Text="Use Online Catalogue:" Foreground="White" VerticalAlignment="Center" Width="160" Margin="0,0,5,0"/>
                <CheckBox x:Name="ToggleSwitchOfflinePshome" Checked="ToggleSwitchOfflineCheckedChanged" Unchecked="ToggleSwitchOfflineCheckedChanged" Style="{StaticResource ModernToggleSwitchStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5,0,5,8">
                <TextBlock Text="Interface Size:" Foreground="White" VerticalAlignment="Center" Width="160" Margin="0,0,5,0"/>
                <ComboBox x:Name="UiScaleCombo" Width="110" Height="26" Style="{StaticResource DarkModeComboBoxStyle}" SelectionChanged="UiScaleCombo_SelectionChanged"
                          ToolTip="Auto makes the window smaller on high-DPI screens (e.g. 4K at 200% or more), where Windows would otherwise show it very large">
                    <ComboBoxItem Content="Auto" Tag="0"/>
                    <ComboBoxItem Content="100%" Tag="100"/>
                    <ComboBoxItem Content="90%" Tag="90"/>
                    <ComboBoxItem Content="80%" Tag="80"/>
                    <ComboBoxItem Content="75%" Tag="75"/>
                    <ComboBoxItem Content="67%" Tag="67"/>
                    <ComboBoxItem Content="60%" Tag="60"/>
                    <ComboBoxItem Content="50%" Tag="50"/>
                </ComboBox>
                <TextBlock x:Name="UiScaleInfo" Foreground="#909090" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="0" Margin="5,5,5,8">
                <TextBlock Text="Show ALL Items:" Foreground="White" VerticalAlignment="Center" Width="163" Margin="0,0,2,0"/>
                <CheckBox x:Name="ToggleSwitchLiteCatalogue" Style="{StaticResource ModernToggleSwitchStyle}" Checked="ToggleSwitchLiteCatalogue_Checked" Unchecked="ToggleSwitchLiteCatalogue_Checked"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" >
                <TextBlock Text="Choose a theme color:" Foreground="White" Margin="5" Width="160"/>
                <ComboBox x:Name="ThemeColorDropdown" Width="60" Height="26" Background="{Binding SelectedThemeColor, Mode=TwoWay}">
                    <ComboBox.Template>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Name="DropDownToggle" Background="{TemplateBinding Background}" Width="60" Height="22">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <!-- Adjusted width here -->
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ColorDisplay" Grid.Column="0" Background="{TemplateBinding Background}"
                            BorderBrush="#101010" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#101010" Opacity="0.5" BlurRadius="5" ShadowDepth="2"/>
                                                    </Border.Effect>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup Name="Popup" IsOpen="{Binding IsChecked, ElementName=DropDownToggle, Mode=TwoWay}" Placement="Right" VerticalOffset="-110" HorizontalOffset="30" PlacementTarget="{Binding ElementName=DropDownToggle}"  StaysOpen="False">
                                    <Border Name="DropDownBorder" BorderBrush="{Binding SelectedThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                BorderThickness="1"  Background="#242424" MaxHeight="200" Margin="0" MaxWidth="200" >
                                        <colorpicker:StandardColorPicker x:Name="NewColorPicker" SelectedColor="{Binding ThemeColor, Mode=TwoWay}" Width="200" Height="380" ColorChanged="NewColorPicker_ColorChanged"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </ComboBox.Template>
                </ComboBox>
            </StackPanel>


        </StackPanel>
    </ScrollViewer>
        <TextBlock Grid.Row="1" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,6,0,10"><Run Text="For Support and Information Visit the Home Laboratory Discord Community "/><Hyperlink NavigateUri="https://discord.gg/VZgTgX5yM7" RequestNavigate="Hyperlink_RequestNavigate"><Run Text="HERE"/></Hyperlink></TextBlock>
    </Grid>
</UserControl>
