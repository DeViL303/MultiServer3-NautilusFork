<UserControl x:Class="Nautilus2027.Path2HashTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nautilus2027"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nautilus2027;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Path to Hash Tool" Margin="10" Style="{StaticResource ToolTitleTextBlockStyle}" AllowDrop="True" Drop="Path2HashTabItem_Drop" />
        <Border x:Name="Path2HashPatcherDragArea" Style="{StaticResource DragAreaStyle}" Drop="Path2HashTabItem_Drop" Height="81" Margin="0,0,0,5" Width="713">
            <TextBlock x:Name="Path2HashDragAreaText" Text="Drag a folder or TXT/XML here to hash all paths" Style="{StaticResource DragAreaTextBlockStyle}"/>
        </Border>
        <Border Background="#242424" Padding="10" AllowDrop="True" Drop="Path2HashTabItem_Drop">
            <Grid>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <!-- Title -->
                    <TextBlock Text="Single Path:" Foreground="White" FontSize="14" Height="20" Margin="0,5,0,5" Width="74"/>
                    <!-- Long Text Entry Box -->
                    <TextBox x:Name="Path2HashInputTextBox" local:FileDrop.Handler="Path2HashTabItem_Drop" Style="{StaticResource SmallTextBoxStyle}" Width="650" />
                    <!-- Hash Button -->
                    <StackPanel  Orientation="Horizontal" HorizontalAlignment="Center" Width="260">
                        <Button Content="Hash" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" AllowDrop="True" Drop="Path2HashTabItem_Drop" Click="Path2HashButton_Click"/>
                        <Button x:Name="Path2HashClearButton" Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="Path2HashClearListHandler"/>
                        <Button Content="Add to Mapper" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" AllowDrop="True" Drop="Path2HashTabItem_Drop" Click="AddToMapperButton_Click" Width="124"/>
                    </StackPanel>
                    <!-- Short Text Output Box -->
                    <TextBox x:Name="Path2HashOutputTextBox" local:FileDrop.Handler="Path2HashTabItem_Drop" Style="{StaticResource SmallTextBoxStyle}" Width="90" />
                </StackPanel>
                <StackPanel AllowDrop="True" Drop="Path2HashTabItem_Drop">
                    <TextBox x:Name="Path2HashOutputExtraTextBox" local:FileDrop.Handler="Path2HashTabItem_Drop" Style="{StaticResource FileList2TextBoxStyle}" Margin="0,130,0,0" Height="480" Width="1350" />
                </StackPanel>
            </Grid>

        </Border>

    </StackPanel>
</UserControl>
