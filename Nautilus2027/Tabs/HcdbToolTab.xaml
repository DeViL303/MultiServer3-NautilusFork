<UserControl x:Class="Nautilus2027.HcdbToolTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nautilus2027"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nautilus2027;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Background="#242424">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: HCDB Encrypter -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="HCDB Packer"  Style="{StaticResource ToolTitleTextBlockStyle}"/>
                <Border x:Name="HCDBEncrypterDragArea" Style="{StaticResource DragAreaStyle2}" Drop="HCDBEncrypterDragDropHandler" MouseLeftButtonUp="ClickToBrowseHCDBEncryptHandler">
                    <TextBlock x:Name="HCDBEncrypterDragAreaText" Text="Drag Folders or SQL Files Here / Click to Browse" Style="{StaticResource DragAreaTextBlockStyle}"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="5"  HorizontalAlignment="Center">
                    <TextBlock Text="Append segs SHA1 to HCDB Filenames:" Style="{StaticResource SceneIdTextBlockStyle}"/>
                    <CheckBox x:Name="HCDBAddSHA1CheckBox" Style="{StaticResource ModernToggleSwitchStyle}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Encrypt" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="HCDBEncrypterExecuteButtonClick"/>
                    <Button x:Name="HCDBEncrypterClearButton" Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="ClearListHandler"/>
                </StackPanel>


                <!-- Text Area -->
                <TextBox x:Name="HCDBEncrypterTextBox" local:FileDrop.Handler="HCDBEncrypterDragDropHandler" Margin="0,16,0,0" Style="{StaticResource FileListTextBoxStyle}" MouseDoubleClick="HCDBEncrypterTextBox_MouseDoubleClick"/>
            </StackPanel>

            <!-- Right Side: HCDB Decrypter -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="HCDB UnPacker" Style="{StaticResource ToolTitleTextBlockStyle}"/>
                <Border x:Name="HCDBDecrypterDragArea" Style="{StaticResource DragAreaStyle2}" Drop="HCDBDecrypterDragDropHandler" MouseLeftButtonUp="ClickToBrowseHCDBDecryptHandler">
                    <TextBlock x:Name="HCDBDecrypterDragAreaText" Text="Drag Folders or HCDB Files Here / Click to Browse" Style="{StaticResource DragAreaTextBlockStyle}"/>
                </Border>

                <!-- SHA1 TextBox -->
                <StackPanel Orientation="Horizontal"  Margin="5" HorizontalAlignment="Center">
                    <TextBlock Text="Segs SHA1 (HCDB Decryption key):" Style="{StaticResource Sha1TextBlockStyle}"/>
                    <TextBox x:Name="HCDBDecrypterSha1TextBox" Style="{StaticResource Sha1TextBoxStyle}" Width="330" MaxLength="40"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                    <Button Content="Decrypt" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="HCDBDecrypterExecuteButtonClick"/>
                    <Button x:Name="HCDBDecrypterClearButton" Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="ClearListHandler"/>
                </StackPanel>

                <!-- Text Area -->
                <TextBox x:Name="HCDBDecrypterTextBox" local:FileDrop.Handler="HCDBDecrypterDragDropHandler" Style="{StaticResource FileListTextBoxStyle}" MouseDoubleClick="HCDBDecrypterTextBox_MouseDoubleClick"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
