<UserControl x:Class="Nautilus2027.CdnAuditTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nautilus2027;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="CDN Audit" Margin="5" Style="{StaticResource ToolTitleTextBlockStyle}" AllowDrop="True" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Label Content="TSS URL:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="70"/>
            <TextBox x:Name="TSSUrlTextBox" Width="400" Style="{StaticResource SmallTextBoxStyle}" Text="http://64.20.35.146/tss/coreHztFmpQrx0002_en-US.xml" Margin="0,0,10,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Label Content="Territory:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="70"/>
            <ComboBox x:Name="TerritoryComboBox" Width="100" Style="{StaticResource DarkModeComboBoxStyle}" SelectedIndex="0">
                <ComboBoxItem Content="SCEE" />
                <ComboBoxItem Content="SCEA" />
                <ComboBoxItem Content="SCEJ" />
                <ComboBoxItem Content="SCEAsia" />
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Label Content="Skip SDC Verification:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="150"/>
            <CheckBox x:Name="SkipSDCVerificationToggle" Style="{StaticResource ModernToggleSwitchStyle}" />
            <Label Content="Skip ODC Verification:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="150"/>
            <CheckBox x:Name="SkipODCVerificationToggle" Style="{StaticResource ModernToggleSwitchStyle}" />
        </StackPanel>
        <Border Background="#242424" Padding="10" AllowDrop="True">
            <Grid>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                        <Button Content="Start" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="StartButton_Click" Margin="5,0,5,10"/>
                        <Button x:Name="XMLClearButton" Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="XMLClearListHandler" Margin="5,0,5,10"/>
                    </StackPanel>
                    <TextBox x:Name="XMLOutputTextBox" Style="{StaticResource FileList2TextBoxStyle}" Margin="0,0,0,0" Height="515" Width="1150" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
