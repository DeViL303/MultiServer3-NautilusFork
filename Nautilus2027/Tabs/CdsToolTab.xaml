<UserControl x:Class="Nautilus2027.CdsToolTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nautilus2027"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nautilus2027;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Background="#242424" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: CDS Encrypter -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="CDS Encrypter" Style="{StaticResource ToolTitleTextBlockStyle}"/>
                <Border x:Name="CDSEncrypterDragArea" Style="{StaticResource DragAreaStyle2}" Drop="CDSEncrypterDragDropHandler" MouseLeftButtonUp="ClickToBrowseCDSEncryptHandler">
                    <TextBlock x:Name="CDSEncrypterDragAreaText" Text="Drag Folders or SDC/ODC/XML Files Here / Click to Browse" Style="{StaticResource DragAreaTextBlockStyle}"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <TextBlock Text="Append SHA1 to Filenames:" Style="{StaticResource SceneIdTextBlockStyle}"/>
                    <CheckBox x:Name="CDSAddSHA1CheckBox" Style="{StaticResource ModernToggleSwitchStyle}"/>
                    <TextBlock Text="Rename for CDN:" Style="{StaticResource ArchiveFormatTextBlockStyle}" Foreground="White" Margin="0,5,0,5" VerticalAlignment="Center"/>
                    <CheckBox x:Name="CDSRenameForCDNCheckBox" Style="{StaticResource ModernToggleSwitchStyle}" />
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Encrypt" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="CDSEncrypterExecuteButtonClick"/>
                    <Button x:Name="CDSEncrypterClearButton" Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="ClearListHandler"/>
                </StackPanel>

                <!-- Text Area -->
                <TextBox x:Name="CDSEncrypterTextBox" local:FileDrop.Handler="CDSEncrypterDragDropHandler" Margin="0,15,0,0" Style="{StaticResource FileListTextBoxStyle}" MouseDoubleClick="CDSEncrypterTextBox_MouseDoubleClick"/>
            </StackPanel>

            <!-- Right Side: CDS Decrypter -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="CDS Decrypter" Style="{StaticResource ToolTitleTextBlockStyle}"/>
                <Border x:Name="CDSDecrypterDragArea" Style="{StaticResource DragAreaStyle2}" Drop="CDSDecrypterDragDropHandler" MouseLeftButtonUp="ClickToBrowseCDSDecryptHandler">
                    <TextBlock x:Name="CDSDecrypterDragAreaText" Text="Drag Folders or SDC/ODC/XML Files Here / Click to Browse" Style="{StaticResource DragAreaTextBlockStyle}"/>
                </Border>

                <!-- SHA1 TextBox -->
                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                    <TextBlock Text="Original SHA1 (Optional):" Style="{StaticResource Sha1TextBlockStyle}"/>
                    <TextBox x:Name="CDSDecrypterSha1TextBox" Style="{StaticResource Sha1TextBoxStyle}" Width="330" MaxLength="40"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Decrypt" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="CDSDecrypterExecuteButtonClick"/>
                    <Button x:Name="CDSDecrypterClearButton" Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="ClearListHandler"/>
                </StackPanel>

                <!-- Text Area -->
                <TextBox x:Name="CDSDecrypterTextBox" local:FileDrop.Handler="CDSDecrypterDragDropHandler" Style="{StaticResource FileListTextBoxStyle}" MouseDoubleClick="CDSDecrypterTextBox_MouseDoubleClick"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
