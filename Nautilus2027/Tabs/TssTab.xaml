<UserControl x:Class="Nautilus2027.TssTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nautilus2027;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Row for URL and buttons -->
            <RowDefinition Height="*"/>
            <!-- Row for content display -->
        </Grid.RowDefinitions>

        <!-- Border around the first two StackPanels -->
        <Border Grid.Row="0" Grid.RowSpan="2" BorderBrush="White" CornerRadius="3" BorderThickness="1" Margin="0,0,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,10,0,5">
                    <TextBlock Text="TSS (Path/URL):" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="white"/>
                    <TextBox x:Name="TSSURLtextbox" Style="{StaticResource ResourceKey=SmallTextBoxStyle}" 
     Text="" 
     IsReadOnly="False" Width="400" Margin="5,0,5,0" TextChanged="TSSURLtextbox_TextChanged" MouseDoubleClick="TSSURLtextbox_MouseDoubleClick"/>
                    <Button Content="Load" Width="45" FontSize="12" Height="24" VerticalAlignment="Center" 
    Style="{StaticResource ResourceKey=DarkModeButtonStyle}" 
    Click="LoadTSSXMLButton_Click" Margin="5,0,30,0" />
                    <TextBlock Text="Deploy to:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="White"/>
                    <TextBox x:Name="TSSeditorSavePathtextbox" Style="{StaticResource ResourceKey=SmallTextBoxStyle}" 
     Text="" 
     IsReadOnly="False" Width="240" Margin="5,0,5,0" TextChanged="TSSeditorSavePathtextbox_TextChanged" MouseDoubleClick="TSSeditorSavePathtextbox_MouseDoubleClick"/>
                    <TextBlock Text="Create for 258 Regions:" Foreground="White" FontSize="11" Margin="15,5,0,5" VerticalAlignment="Center"/>
                    <CheckBox x:Name="CheckBoxTSSAllregions" IsChecked="True" Style="{StaticResource ModernToggleSwitchStyle}" />
                    <Button Content="Save TSS and Deploy" FontSize="12" Width="170" Height="24" VerticalAlignment="Center" 
    Style="{StaticResource ResourceKey=DarkModeButtonStyle}" 
    Click="SaveNewTSSXMLButton_Click" Margin="5,0,0,0" />
                    <TextBlock  x:Name="TSSsaveWarningTextblock"  Text="Warning: Unsaved Changes!" Foreground="Yellow" FontSize="14" Margin="15,0,0,2" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,5" >
                    <StackPanel x:Name="LatestSceneListSHA1panel" Orientation="Horizontal" Margin="2,0,0,5" Visibility="Collapsed">
                        <TextBlock Text="New SceneList Ready to Deploy:" FontWeight="Bold" Margin="2,0,2,0" FontSize="14" VerticalAlignment="Center" Foreground="yellow"/>
                        <TextBox x:Name="LatestSceneListSHA1textbox" Style="{StaticResource ResourceKey=SmallTextBoxStyle}" 
Text="You must Export a SceneList in SceneList Tab First" 
IsReadOnly="False" Width="370" Margin="5,0,5,0" />
                        <Button Content="Apply SHA1" Width="80" Height="24" Foreground="yellow" VerticalAlignment="Center" 
Style="{StaticResource ResourceKey=DarkModeButtonStyle2}" 
Click="ApplyNewSceneListSHA1Button_Click" Margin="5,0,15,0" />
                    </StackPanel>
                    <StackPanel x:Name="LatestHCDBSHA1panel" Orientation="Horizontal" Margin="2,0,0,5" Visibility="Collapsed">
                        <TextBlock Text="New HCDB Ready to Deploy:" FontWeight="Bold" Margin="5,0,0,0" FontSize="14" VerticalAlignment="Center" Foreground="yellow"/>
                        <TextBox x:Name="LatestHCDBSHA1textbox" Style="{StaticResource ResourceKey=SmallTextBoxStyle}" 
Text="You must Export a HCDB in DB Editor Tab First" 
IsReadOnly="False" Width="370" Margin="5,0,5,0"/>
                        <Button Content="Apply SHA1" Width="80" Height="24" Foreground="yellow" VerticalAlignment="Center" 
Style="{StaticResource ResourceKey=DarkModeButtonStyle2}" 
Click="ApplyNewHCDBSHA1Button_Click" Margin="5,0,35,0"/>
                    </StackPanel>


                    
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
Grid.Row="2" Margin="2">
            <StackPanel x:Name="TSSXMLControlsPanel" Margin="2"/>
        </ScrollViewer>
    </Grid>
</UserControl>
