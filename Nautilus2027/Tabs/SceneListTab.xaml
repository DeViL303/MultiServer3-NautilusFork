<UserControl x:Class="Nautilus2027.SceneListTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nautilus2027;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
           
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Border around the StackPanel -->
        <Border BorderBrush="white" BorderThickness="1" CornerRadius="3,3,0,0" Margin="0" Grid.Row="0" Padding="10">
            <StackPanel Orientation="Vertical" Margin="0">
                <!-- Existing content in the first row -->
                <StackPanel Orientation="Horizontal" Margin="0">
                    <TextBlock Text="Name (ID):" Width="70" FontSize="14" Margin="0,3,0,5" Foreground="White"/>
                    <TextBox x:Name="txtSdcName" Width="265" Margin="1,0" Style="{StaticResource SmallTextBoxStyle3}" Text="" MouseDoubleClick="txtObjectId_MouseDoubleClick"/>
                    <TextBlock Text="Config:" Width="50" FontSize="14" Margin="10,3,0,5" Foreground="White"/>
                    <TextBox x:Name="txtsceneconfig" Width="400" Margin="1,0" Style="{StaticResource SmallTextBoxStyle3}" Text=""/>
                    <TextBlock Text="Scene Type:" Width="72" FontSize="14" Margin="10,3,5,5" Foreground="White"/>
                    <ComboBox x:Name="txtSceneType" Height="22" Padding="2" Width="105" FontSize="12" Margin="1,0" Style="{StaticResource DarkModeComboBoxStyle}" SelectionChanged="txtSceneType_SelectionChanged">
                        <ComboBoxItem Content="GlobalSpace"/>
                        <ComboBoxItem Content="Home"/>
                        <ComboBoxItem Content="PublicLobby"/>
                        <ComboBoxItem Content="Game16Space"/>
                        <ComboBoxItem Content="Game32Space"/>
                        <ComboBoxItem Content="Game60Space"/>
                        <ComboBoxItem Content="PublicNoVideo"/>
                        <ComboBoxItem Content="PrivateNoVideo"/>
                        <ComboBoxItem Content="ArcadeSpace"/>
                    </ComboBox>

                    <TextBlock Text="Host:" FontSize="14" Margin="10,3,5,5" Foreground="White"/>
                    <ComboBox x:Name="txtdHost" Height="22" Padding="2" Width="55" FontSize="12" Margin="1,0" Style="{StaticResource DarkModeComboBoxStyle}">
                        <ComboBoxItem Content="en-US"/>
                        <ComboBoxItem Content="en-GB"/>
                        <ComboBoxItem Content="ja-JP"/>
                        <ComboBoxItem Content=""/>
                    </ComboBox>
                   
                    <TextBlock Text="HOMEUID:" FontSize="14" Margin="10,3,5,5" Foreground="White"/>
                    <TextBox x:Name="txthomeuuid" Width="35" Margin="1,0" Style="{StaticResource SmallTextBoxStyle3}" Text=""/>
                    <TextBlock Text="Vers:" FontSize="14" Margin="10,3,5,5" Foreground="White"/>
                    <TextBox x:Name="txtSDCversion" Width="30" Margin="1,0" Style="{StaticResource SmallTextBoxStyle3}" Text="1"/>
                    <Button Content="Reset" Width="60" Height="20" Padding="0" FontSize="9" FontWeight="Bold" Style="{StaticResource DarkModeButtonStyle}" Margin="6,0,0,0" VerticalAlignment="Center" Click="ResetSDCInfo_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0">
                    <TextBlock Text="ChannelID:" Width="70" FontSize="14" Margin="0,3,0,5" Foreground="White"/>
                    <TextBox x:Name="txtChannelID" Width="265" Margin="1,3" Style="{StaticResource SmallTextBoxStyle3}" Text="" MouseDoubleClick="txtChannelID_MouseDoubleClick"/>
                    <TextBlock Text="Desc:" Width="50" FontSize="14" Margin="10,3,0,5" Foreground="White"/>
                    <TextBox x:Name="txtSdcPath" Width="400" Margin="1,0" Style="{StaticResource SmallTextBoxStyle3}" Text=""/>
                    <TextBlock Text="SDC SHA1:" Width="72" FontSize="14" Margin="10,3,5,5" Foreground="White"/>
                    <TextBox x:Name="txtSdcsha1Digest" Width="325" Margin="1,0" Style="{StaticResource SmallTextBoxStyle3}" Text=""/>
                    <TextBlock Text="Flags:" FontSize="14" Margin="10,3,5,5" Foreground="White"/>
                    <TextBox x:Name="txtflags" Width="25" Margin="1,0" Style="{StaticResource SmallTextBoxStyle3}" Text=""/>
                    <Button Content="Add Item" Width="60" Height="20" Padding="0" FontSize="9" FontWeight="Bold" Style="{StaticResource DarkModeButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Click="AddNewScenelistItem_Button_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- New border and row for the specified StackPanel -->
        <Border BorderBrush="white" BorderThickness="1" CornerRadius="0,0,3,3" Margin="0,-21,0,21" Grid.Row="2" Padding="10">
            <StackPanel Orientation="Horizontal" Margin="0">
                <TextBlock Text="SceneList (Path/URL):" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="White"/>
                <TextBox x:Name="SceneListPathURLtextbox2" Style="{StaticResource ResourceKey=SmallTextBoxStyle}" 
    Text="" 
    IsReadOnly="False" Width="395" Margin="5,0,5,0" TextChanged="SceneListPathURLtextbox2_TextChanged" MouseDoubleClick="SceneListPathURLtextbox2_MouseDoubleClick"/>
                <Button Content="Load" Width="45" FontSize="12" VerticalAlignment="Center" 
    Style="{StaticResource ResourceKey=DarkModeButtonStyle}" 
    Click="LoadSceneListXMLv2intoEditorButton_Click" Margin="5,0,15,0" />
                <TextBlock Text="Save to:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="White"/>
                <TextBox x:Name="SceneListSavePathtextbox" Style="{StaticResource ResourceKey=SmallTextBoxStyle}" 
    Text="" 
    IsReadOnly="False" Width="355" Margin="5,0,5,0" TextChanged="SceneListSavePathtextbox_TextChanged" MouseDoubleClick="SceneListSavePathtextbox_MouseDoubleClick"/>
                <TextBlock Text="Encrypt:" Foreground="White" FontSize="11" Margin="5,5,0,5" VerticalAlignment="Center"/>
                <CheckBox x:Name="CheckBoxEncryptSceneList" IsChecked="True" Style="{StaticResource ModernToggleSwitchStyle}" />
                <Button Content="Save SceneList"  FontSize="12" Width="100" VerticalAlignment="Center"
    Style="{StaticResource ResourceKey=DarkModeButtonStyle}"
    Click="SaveSceneListXmlButton_Click" Margin="0,0,0,0" />
                <TextBlock x:Name="UnsavedSceneListChanges" Width="190" Text="Warning: Unsaved Changes!" Visibility="Hidden" FontSize="15" Foreground="yellow" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Name="SceneListHeaderGrid" Grid.Row="3" Background="Transparent" Margin="0,-16,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="29"/>
                <ColumnDefinition Width="259"/>
                <ColumnDefinition Width="309"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <Label Content="Name (ID)" FontSize="12" Foreground="White" Background="#484848" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="2,0" Margin="1,0" Grid.Column="0"/>
            <Label Content="Scene Type" FontSize="12" Foreground="White" Background="#484848" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="2,0" Margin="1,0" Grid.Column="1"/>
            <Label Content="SDC Path on CDN (Desc)" FontSize="12" Foreground="White" Background="#484848" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="2,0" Margin="1,0" Grid.Column="2"/>
            <Label Content="Scene File Path in Archive (Config)" FontSize="12" Foreground="White" Background="#484848" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="2,0" Margin="1,0" Grid.Column="3"/>
            <Label Content="Ver" FontSize="12" Foreground="White" Background="#484848" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="2,0" Margin="1,0" Grid.Column="4"/>
            <Label Content="SceneID / ChannelID" FontSize="12" Foreground="White" Background="#484848" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="2,0" Margin="1,0" Grid.Column="5"/>
            <Label Content="SDC SHA1 Digest" FontSize="12" Foreground="White" Background="#484848" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="2,0" Margin="1,0" Grid.Column="6"/>
            <Label Content="Delete" FontSize="12" Foreground="White" Background="#484848" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="2,0" Margin="1,0" Grid.Column="7"/>
        </Grid>

        <Canvas>
            <Border 
Style="{StaticResource DragAreaStyle}"
Width="85"
Margin="0"
Height="50"  
Canvas.Right="10" 
Canvas.Top="13"
AllowDrop="True"
DragEnter="Border_DragSDCEnter"
Drop="Border_SDCDrop"
MouseLeftButtonUp="Border_SDCMouseLeftButtonUp">
                <TextBlock Text="Drag SDC" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
            </Border>

        </Canvas>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="scenesList" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <TextBox Text="{Binding ID}" Width="206" Margin="1,0" Style="{StaticResource SmallTextBoxStyleScenelist}" Foreground="White" TextChanged="TextBox_TextChanged"/>
                            <TextBox Text="{Binding Type}" Width="98" Margin="1,0" Style="{StaticResource SmallTextBoxStyleScenelist}" Foreground="White" TextChanged="TextBox_TextChanged"/>
                            <TextBox Text="{Binding Description}" Width="258" Margin="1,0" Style="{StaticResource SmallTextBoxStyleScenelist}" Foreground="White" TextChanged="TextBox_TextChanged"/>
                            <TextBox Text="{Binding Config}" Width="258" Margin="1,0" Style="{StaticResource SmallTextBoxStyleScenelist}" Foreground="White" TextChanged="TextBox_TextChanged"/>
                            <TextBox Text="{Binding Version}" Width="27" Margin="1,0" Style="{StaticResource SmallTextBoxStyleScenelist}" Foreground="White" TextChanged="TextBox_TextChanged"/>
                            <TextBox Text="{Binding SceneID}" Width="257" Margin="1,0" Style="{StaticResource SmallTextBoxStyleScenelist}" Foreground="White" TextChanged="TextBox_TextChanged"/>
                            <TextBox Text="{Binding SHA1}" Width="307" Margin="1,0" Style="{StaticResource SmallTextBoxStyleScenelist}" Foreground="White" TextChanged="TextBox_TextChanged"/>
                            <Button Content="Del" Width="25" FontSize="9" Foreground="red" Height="20" Padding="0" Margin="1,0" Style="{StaticResource ResourceKey=DarkModeButtonStyle2_NoPadding}"
                Click="DeleteSceneListXMLLineButton_Click"
                DataContext="{Binding}"
                Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type FrameworkElement}}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
