<UserControl x:Class="Nautilus2027.LuaToolTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nautilus2027"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nautilus2027;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Background="#242424"  >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: LUA Compiler -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="LUA Compiler" Style="{StaticResource ToolTitleTextBlockStyle}"/>
                <Border x:Name="LUACompilerDragArea" Style="{StaticResource DragAreaStyle2}" Drop="LuaDragDropHandler" MouseLeftButtonUp="ClickToBrowseHandlerLUACompiler">
                    <TextBlock x:Name="LUACompilerDragAreaText" Text="Drag Folders or LUA Files Here / Click to Browse" Style="{StaticResource DragAreaTextBlockStyle}"/>
                </Border>

                <!-- Toggle and Button -->
                <StackPanel Orientation="Horizontal"  Margin="5" HorizontalAlignment="Center">
                    <TextBlock Text="Parse Only:" Style="{StaticResource Sha1TextBlockStyle}" />
                    <CheckBox x:Name="CheckBoxParseOnly" Style="{StaticResource ModernToggleSwitchStyle}" Background="Gray" Unchecked="CheckBoxLUACParseOnly_Unchecked" Checked="CheckBoxLUACParseOnly_Checked"/>
                    <TextBlock Text="Strip Debug Info:" Style="{StaticResource Sha1TextBlockStyle}" />
                    <CheckBox x:Name="CheckBoxStripDebug" Style="{StaticResource ModernToggleSwitchStyle}" Background="Gray" Unchecked="CheckBoxLUACStripDebug_Unchecked" Checked="CheckBoxLUACStripDebug_Checked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Compile" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="LUACompilerExecuteButtonClick"/>
                    <Button x:Name="LUACompilerClearButton" Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="StopandClearLUAListHandler"/>
                </StackPanel>

                <!-- Text Area -->
                <TextBox x:Name="LUACompilerTextBox" local:FileDrop.Handler="LuaDragDropHandler" Style="{StaticResource FileListTextBoxStyle}" MouseDoubleClick="LUACompilerTextBox_MouseDoubleClick"/>
            </StackPanel>

            <!-- Right Side: LUAC Decompiler -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="LUAC Decompiler" Style="{StaticResource ToolTitleTextBlockStyle}"/>
                <Border x:Name="LUACDecompilerDragArea" Style="{StaticResource DragAreaStyle2}" Drop="LuacDragDropHandler" MouseLeftButtonUp="ClickToBrowseHandlerLUACDecompiler">
                    <TextBlock x:Name="LUACDecompilerDragAreaText" Text="Drag Folders or LUAC Files Here / Click to Browse" Style="{StaticResource DragAreaTextBlockStyle}"/>
                </Border>


                <!-- Radio Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="25,5,0,5" Width="461">
                    <TextBlock Text="Metaworm (Best):" Style="{StaticResource Sha1TextBlockStyle}" Foreground="White" Margin="7,10" VerticalAlignment="Center"/>
                    <RadioButton x:Name="LUACDecompilerRadioButtonMetaworm" GroupName="UnluacVersion" Style="{StaticResource ModernRadioButtonStyle}" IsChecked="True" Checked="LUACDecompilerRadioButtonMetaworm_Checked" />
                    <TextBlock Text=".NET:" Style="{StaticResource Sha1TextBlockStyle}" Foreground="White" Margin="7,10" VerticalAlignment="Center"/>
                    <RadioButton x:Name="LUACDecompilerRadioButtonUnluacNET" GroupName="UnluacVersion" Style="{StaticResource ModernRadioButtonStyle}" Checked="LUACDecompilerRadioButtonUnluacNET_Checked" />
                    <TextBlock Text="JAR v1.22:" Style="{StaticResource Sha1TextBlockStyle}" Foreground="White" Margin="7,10" VerticalAlignment="Center"/>
                    <RadioButton x:Name="LUACDecompilerRadioButtonUnluac122" GroupName="UnluacVersion" Style="{StaticResource ModernRadioButtonStyle}" Checked="LUACDecompilerRadioButtonUnluac122_Checked" />
                    <TextBlock Text="Dec 2023 JAR:" Style="{StaticResource Sha1TextBlockStyle}" Foreground="White" Margin="7,10" VerticalAlignment="Center"/>
                    <RadioButton x:Name="LUACDecompilerRadioButtonUnluac2023" GroupName="UnluacVersion" Style="{StaticResource ModernRadioButtonStyle}" Checked="LUACDecompilerRadioButtonUnluac2023_Checked" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Decompile" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="LUACDecompilerExecuteButtonClick"/>
                    <Button x:Name="LUACDecompilerClearButton" Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="ClearListHandler"/>
                </StackPanel>

                <!-- Text Area -->
                <TextBox x:Name="LUACDecompilerTextBox" local:FileDrop.Handler="LuacDragDropHandler" Style="{StaticResource FileListTextBoxStyle}" MouseDoubleClick="LUACDecompilerTextBox_MouseDoubleClick"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
