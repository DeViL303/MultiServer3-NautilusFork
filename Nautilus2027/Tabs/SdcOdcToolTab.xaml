<UserControl x:Class="Nautilus2027.SdcOdcToolTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nautilus2027"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nautilus2027;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#242424"
          DragEnter="Grid_DragEnter" 
        Drop="Grid_Drop" 
        AllowDrop="True" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Form for SDC File Creation -->
        <StackPanel DragEnter="Grid_DragEnter" 
        Drop="Grid_Drop" 
        AllowDrop="True" Grid.Column="0" Margin="10">
            <TextBlock Text="SDC Creation" Style="{StaticResource ToolTitleTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Name:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="sdcNameTextBox" Style="{StaticResource SmallTextBoxStyle}" Width="435" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"  Width="570">
                <Label Content="Description:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="sdcDescriptionTextBox" Style="{StaticResource SmallTextBoxStyle}" Width="435" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Maker:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="sdcMakerTextBox" Text="Sony Computer Entertainment" Style="{StaticResource SmallTextBoxStyle}" Width="435" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="HDK Version:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="sdcHDKVersionTextBox" Text="1.86.0.17.PUB" Style="{StaticResource SmallTextBoxStyle}" Width="435" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Txxx Version:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="sdcThumbnailSuffixTextBox" Style="{StaticResource SmallTextBoxStyle}" Width="435"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Archive Path:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="sdcServerArchivePathTextBox" Text="Scenes/" Style="{StaticResource SmallTextBoxStyle}"  Width="435"/>

            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Timestamp:" Foreground="White"  FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="sdcTimestampTextBox" Style="{StaticResource SmallTextBoxStyle}" Text="FFFFFFFF" Width="90" />
                <Label Content="Archive Size:" Foreground="White" FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center" Width="90"/>
                <TextBox x:Name="sdcArchiveSizeTextBox" Style="{StaticResource SmallTextBoxStyle}" Width="110" />
                <TextBlock Text="Offline SDC:" Style="{StaticResource Toggle1TextBlockStyle}" Margin="15,0,0,0" VerticalAlignment="Center" Width="65"/>
                <CheckBox x:Name="offlineSDCCheckBox" Checked="CheckBoxOfflineSDC_Checked" Style="{StaticResource ModernToggleSwitchStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570" Margin="0,10,0,0">
                <Label Content="SHA1 Digest:" Foreground="White" FontSize="14" VerticalAlignment="Center"  Width="105"/>
                <TextBox x:Name="Createdsdcsha1TextBox" Style="{StaticResource SmallTextBoxStyle}" Background="#181818" IsReadOnly="True" Width="375"/>
                <Button Content="Copy" Margin="10,0,0,0" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" FontSize="12" Height="25" Click="SDCCopySHA1Button_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  Margin="0,10,0,0">
                <Label Content="Create SHA1 Encrypted SDC:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="190"/>
                <CheckBox x:Name="EncryptSDCCheckBox" IsChecked="True" Style="{StaticResource ModernToggleSwitchStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Create SDC" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="CreateSdcButton_Click"/>
                <Button Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="CreateSdcClearButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="SDC Content" Style="{StaticResource SceneIdTextBlockStyle}" Margin="0,10,0,-7"/>
                <TextBox x:Name="SDCCreatorTextbox" local:FileDrop.Handler="Grid_Drop" Width="600" Height="350" Style="{StaticResource FileListTextBoxStyle}"/>
            </StackPanel>
        </StackPanel>
        <!-- Right Form for ODC File Creation -->
        <StackPanel DragEnter="Grid_DragEnter" 
        Drop="Grid_Drop" 
        AllowDrop="True" Grid.Column="1" Margin="10">
            <TextBlock Text="ODC Creation" Style="{StaticResource ToolTitleTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Name:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="odcNameTextBox" Style="{StaticResource SmallTextBoxStyle}" Width="435" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Description:" Foreground="White" FontSize="14" VerticalAlignment="Center"  Width="105"/>
                <TextBox x:Name="odcDescriptionTextBox" Style="{StaticResource SmallTextBoxStyle}" Width="435"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Maker:" Foreground="White" FontSize="14" VerticalAlignment="Center"  Width="105"/>
                <TextBox x:Name="odcMakerTextBox" Style="{StaticResource SmallTextBoxStyle}" Text="Sony Computer Entertainment" Width="435"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="HDK Version:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="odcHDKVersionTextBox" Style="{StaticResource SmallTextBoxStyle}" Text="1.86.0.17.PUB" Width="435" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Txxx Version:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="105"/>
                <TextBox x:Name="odcThumbnailSuffixTextBox" Style="{StaticResource SmallTextBoxStyle}" Width="434"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="565">
                <Label Content="UUID:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="104"/>
                <TextBox x:Name="odcUUIDTextBox" Style="{StaticResource SmallTextBoxStyle}" Width="320"/>
                <Button Content="Generate UUID" Margin="10,0,0,0" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" FontSize="12" Height="25" Click="ODCGenerateUUIDButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Width="570">
                <Label Content="Timestamp:" Foreground="White" FontSize="14" VerticalAlignment="Center"  Width="105"/>
                <TextBox x:Name="odcTimestampTextBox" Style="{StaticResource SmallTextBoxStyle}" Text="FFFFFFFF" Width="435"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Width="570">
                <Label Content="SHA1 Digest:" Foreground="White" FontSize="14" VerticalAlignment="Center"  Width="105"/>
                <TextBox x:Name="Createdodcsha1TextBox" Style="{StaticResource SmallTextBoxStyle}" Background="#181818" IsReadOnly="True" Width="375"/>
                <Button Content="Copy" Margin="10,0,0,0" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" FontSize="12" Height="25" Click="ODCCopySHA1Button_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Label Content="Create SHA1 Encrypted ODC:" Foreground="White" FontSize="14" VerticalAlignment="Center" Width="190"/>
                <CheckBox x:Name="EncryptODCCheckBox" IsChecked="True" Style="{StaticResource ModernToggleSwitchStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Create ODC" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="ODCCreateODC_Click"/>
                <Button Content="Clear" Style="{StaticResource ResourceKey=DarkModeButtonStyle}" Click="CreateOdcClearButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock Text="ODC Content" Style="{StaticResource SceneIdTextBlockStyle}" Margin="0,10,0,-7"/>
                <TextBox x:Name="ODCCreatorTextbox" local:FileDrop.Handler="Grid_Drop" Width="600" Height="350" Style="{StaticResource FileListTextBoxStyle}"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</UserControl>
