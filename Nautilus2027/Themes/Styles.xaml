    <Style x:Key="ModernRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="0,0,0,0"/>
        <Setter Property="Margin" Value="-10,0,5,0"/>
        <Setter Property="Background" Value="#383838"/>
        <Setter Property="BorderBrush" Value="#000000"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" 
                  VerticalAlignment="{TemplateBinding VerticalAlignment}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="RadioButtonBorder" Width="26" Height="26" CornerRadius="13" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        Margin="4" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF444444" BlurRadius="5" Opacity="0.9" ShadowDepth="2" Direction="315"/>
                            </Border.Effect>
                            <Ellipse x:Name="CheckMark" Fill="{Binding SelectedThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            <Setter Property="Background" Value="#101010"/>
                            <Setter Property="BorderBrush" Value="#000000"/>
                            <Setter TargetName="RadioButtonBorder" Property="Opacity" Value="1"/>
                            <Setter TargetName="RadioButtonBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="RadioButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter TargetName="RadioButtonBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#101010" BlurRadius="2" Opacity="0" ShadowDepth="0" Direction="315"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="RadioButtonBorder" Property="BorderThickness" Value="3"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF888888"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="#FF444444"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Tick box for the pop-up windows: dark box, theme-coloured tick -->
    <Style x:Key="DarkCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" CornerRadius="3"
                                Background="#101010" BorderBrush="#000000" BorderThickness="1">
                            <Path x:Name="tick" Data="M 2.5,7.5 L 6,11 L 12.5,3.5" StrokeThickness="2" Visibility="Collapsed"
                                  Stroke="{Binding SelectedThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{Binding SelectedThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernToggleSwitchStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Width" Value="43"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="5,0,15,0"/>
        <Setter Property="Padding" Value="0,0,0,0"/>
        <Setter Property="Background" Value="#101010"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="toggleBorder" Width="{TemplateBinding Width}" 
                    Height="{TemplateBinding Height}" 
                    CornerRadius="2" 
                    Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF444444" BlurRadius="2" Opacity="0.5" ShadowDepth="2" Direction="315"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Adjusted Rectangle with a Stroke for the border -->
                            <Rectangle x:Name="toggleRectangle" Fill="#101010" RadiusX="12" RadiusY="13" Stroke="#000000" StrokeThickness="1"/>
                            <Ellipse x:Name="SwitchThumb" Fill="#444444" 
                             Width="18" Height="18" 
                             HorizontalAlignment="Left" 
                             Margin="2.5"
                             VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,2.5,2.5,2.5"/>
                            <Setter TargetName="SwitchThumb" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="toggleRectangle" Property="StrokeThickness" Value="2.5"/>
                            <Setter TargetName="toggleRectangle" Property="Stroke" Value="#101010"/>
                            <Setter TargetName="toggleRectangle" Property="Fill" Value="#101010"/>
                            <Setter Property="Background" Value="{Binding SelectedThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="{Binding SelectedThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                           
                            <Setter TargetName="toggleBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="0" Y="0"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="toggleBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter TargetName="toggleBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF444444" BlurRadius="1" Opacity="0.5" ShadowDepth="1" Direction="315"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#242424"/>
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="#FF888888"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                           
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernToggleSwitchStyleGrey" TargetType="{x:Type CheckBox}">
        <Setter Property="Opacity" Value="0.60"/>
        <Setter Property="Width" Value="43"/>
        <Setter Property="Height" Value="24"/>
